{
  "name": "jest-pr-reporter",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that turns Jest results into a sticky PR comment, inline check annotations, a job summary, and pass/fail gating.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "all": "npm run format:check && npm run lint && npm run typecheck && npm run test:ci && npm run build"
  },
  "keywords": [
    "github-action",
    "jest",
    "test-report",
    "coverage",
    "pull-request",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chathurabuddi/jest-check-action.git"
  },
  "bugs": {
    "url": "https://github.com/chathurabuddi/jest-check-action/issues"
  },
  "homepage": "https://github.com/chathurabuddi/jest-check-action#readme",
  "author": "Chathura Buddhika",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.17.0",
    "eslint-plugin-jest": "^28.10.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
